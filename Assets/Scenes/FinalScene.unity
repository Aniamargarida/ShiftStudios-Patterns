  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\nMY THERAPY NOTES\r\n\r\nRECOGNIZING THE CYCLE\r\n\r\nI've already
    checked everything.\r\nBut the doubt keeps coming back.\r\nChecking again makes
    me feel better for a moment, but then I start questioning it all over again.\r\n\r\nI
    CAN CONTINUE\r\n\r\nI don't need to feel completely certain.\r\nI've done what
    I needed to do.\r\nI can leave the house even if the uncomfortable feeling is
    still there.\r\n\n\r\nClick anywhere to close.\r\n  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
